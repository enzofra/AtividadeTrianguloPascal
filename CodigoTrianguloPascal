#include <stdio.h>
#include <stdlib.h>

unsigned long long fatorial(int n) {
    if (n == 0 || n == 1)
        return 1;
    unsigned long long fat = 1;
    for (int i = 2; i <= n; i++) {
        fat *= i;
    }
    return fat;
}

unsigned long long combinacao(int n, int p) {
    if (p > n) return 0;
    return fatorial(n) / (fatorial(p) * fatorial(n - p));
}

int main() {
    int linhas;

    printf("Digite o numero de linhas para o Triangulo de Pascal: ");
    scanf("%d", &linhas);

    printf("\n--- Triangulo de Pascal (%d linhas) ---\n", linhas);
    for (int i = 0; i < linhas; i++) {
        printf("linha %d : ", i);
        for (int j = 0; j <= i; j++) {
            printf("%4llu", combinacao(i, j));
        }
        printf("\n");
    }
    printf("---------------------------------------\n");

    return 0;
}
